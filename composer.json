{
    "name": "radoslav/odds-comparison",
    "description": "Live odds comparison plugin for WordPress: pluggable odds sources, cached fetching, admin controls and a Gutenberg block.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Radoslav Zdravković"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "OddsComparison\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OddsComparison\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
