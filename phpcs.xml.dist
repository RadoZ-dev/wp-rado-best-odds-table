<?xml version="1.0"?>
<ruleset name="Odds Comparison">
    <description>PSR-12 (a superset of PSR-2) for all plugin PHP.</description>

    <file>odds-comparison.php</file>
    <file>src</file>
    <file>tests</file>
    <file>config</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- The bootstrap file must declare the plugin header and run side effects. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>odds-comparison.php</exclude-pattern>
    </rule>
</ruleset>
