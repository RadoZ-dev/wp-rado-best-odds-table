<?xml version="1.0"?>
<ruleset name="Best Odds Table">
    <description>PSR-12 (a superset of PSR-2) for all plugin PHP.</description>

    <file>best-odds-table.php</file>
    <file>uninstall.php</file>
    <file>src</file>
    <file>tests</file>
    <file>config</file>
    <file>views</file>
    <file>blocks</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Escaped template attributes run long; 150 keeps them readable on one line. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="150"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!-- The bootstrap file must declare the plugin header and run side effects. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>best-odds-table.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
    </rule>
</ruleset>
